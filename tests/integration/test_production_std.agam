இறக்குமதி "std/thread.agam";
இறக்குமதி "std/crypto.agam";
இறக்குமதி "std/regex.agam";
இறக்குமதி "std/datetime.agam";
இறக்குமதி "std/cli.agam";
இறக்குமதி "std/sqlite.agam";
இறக்குமதி "std/io.agam";

செயல் மைய(): எண் {
    // 1. Test Crypto (Base64 and SHA-256)
    மாறி என்: சரம் = பேஸ்64_குறியாக்கு("Agam Enterprise");
    வரியிறக்கி_பதிப்பி(என்);

    மாறி டீ: சரம் = பேஸ்64_டிகோட்(என்);
    வரியிறக்கி_பதிப்பி(டீ);

    மாறி ஹேஷ்: சரம் = ஷாஹா256("Agam Enterprise");
    வரியிறக்கி_பதிப்பி(ஹேஷ்);

    // 2. Test Regex
    மாறி ப: மெய்மை = சீரான_வெளிப்பாடு_தேடு("hello 123", "[0-9]+");
    எனில் (ப) {
        வரியிறக்கி_பதிப்பி("REGEX MATCH PASSED");
    }

    // 3. Test DateTime
    மாறி த: சரம் = தற்போதைய_தேதி();
    வரியிறக்கி_பதிப்பி(த);

    // 4. Test SQLite DB
    மாறி எச்: எண் = தரவுத்தளம்_திற("test.db");
    மாறி இயங்கு: மெய்மை = தரவுத்தளம்_இயக்கு(எச், "CREATE TABLE test(id INT);");
    எனில் (இயங்கு) {
        வரியிறக்கி_பதிப்பி("SQLITE DB EXEC PASSED");
    }

    விடை 0;
}
