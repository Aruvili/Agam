இறக்குமதி "std/string.agam";
இறக்குமதி "std/fs.agam";
இறக்குமதி "std/random.agam";
இறக்குமதி "std/hashmap.agam";
இறக்குமதி "std/io.agam";

செயல் மைய(): எண் {
    // 1. Test String Functions
    மாறி உ: சரம் = மேல்_எழுத்து("hello agam");
    வரியிறக்கி_பதிப்பி(உ);

    மாறி க: சரம் = கீழ்_எழுத்து("AGAM COMPILER");
    வரியிறக்கி_பதிப்பி(க);

    மாறி ப: மெய்மை = சரம்_உள்ளது(உ, "HELLO");
    எனில் (ப) {
        வரியிறக்கி_பதிப்பி("STRING CONTAINS PASSED");
    }

    // 2. Test FS Functions
    மாறி ங: மெய்மை = கோப்பு_உள்ளது("CMakeLists.txt");
    எனில் (ங) {
        வரியிறக்கி_பதிப்பி("FILE EXISTS PASSED");
    }

    // 3. Test Random Functions
    மாறி ர: எண் = சீரற்ற_எண்(1, 10);
    எனில் (ர >= 1) {
        வரியிறக்கி_பதிப்பி("RANDOM PASSED");
    }

    // 4. Test HashMap Functions
    மாறி m: வரைபடம் = வரைபடம்_உருவாக்கு();
    மாறி m2: வரைபடம் = வரைபடம்_சேர்(m, 100, 200);
    வரியிறக்கி_பதிப்பி(வரைபடம்_அளவு(m2));

    விடை 0;
}
