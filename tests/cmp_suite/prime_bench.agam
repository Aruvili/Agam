இறக்குமதி "std/math.agam";
இறக்குமதி "std/io.agam";

செயல் மைய(): எண் {
    மாறி வரம்பு: எண் = 100000;
    மாறி நிலை எண்ணிக்கை: எண் = 0;
    மாறி நிலை எண்_வரிசை: எண் = 2;
    
    வரை (எண்_வரிசை < வரம்பு) {
        மாறி நிலை பகா: மெய்மை = உண்மை;
        மாறி நிலை i: எண் = 2;
        மாறி உச்சம்: எண் = வர்க்கமூலம்(எண்_வரிசை ஆக தசமம்64) ஆக எண்;
        
        வரை (i <= உச்சம்) {
            எனில் (எண்_வரிசை % i == 0) {
                பகா = பொய்;
                i = உச்சம் + 1;
            } இல்லையெனில் {
                i = i + 1;
            }
        }
        
        எனில் (பகா) {
            எண்ணிக்கை = எண்ணிக்கை + 1;
        }
        எண்_வரிசை = எண்_வரிசை + 1;
    }
    
    வரியிறக்கி_பதிப்பி(எண்ணிக்கை);
    விடை 0;
}
